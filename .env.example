# ── Aryx environment variables (set these in Vercel → Project → Settings → Environment Variables) ──

# Neon Postgres connection string (required for auth).
# Neon dashboard → your project → Connection Details → "Pooled connection" string.
DATABASE_URL=postgresql://user:password@ep-xxxx-pooler.region.aws.neon.tech/neondb?sslmode=require

# Secret used to sign session cookies (required in production).
# Generate one:  openssl rand -hex 32
SESSION_SECRET=replace-with-a-long-random-string

# Secret guarding the one-time DB setup endpoint /api/init?secret=...
INIT_SECRET=replace-with-another-random-string

# ── Email delivery (optional) ──
# If BOTH are set, verification codes are emailed via Resend (https://resend.com).
# If unset, the app runs in DEV mode and returns the code to the browser so you can test.
RESEND_API_KEY=
EMAIL_FROM=Aryx <noreply@yourdomain.com>
