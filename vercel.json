{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/api/fred", "destination": "/api/feed/fred" },
    { "source": "/api/stocks", "destination": "/api/feed/stocks" },
    { "source": "/api/world", "destination": "/api/feed/world" },
    { "source": "/api/metals", "destination": "/api/feed/metals" },
    { "source": "/api/market", "destination": "/api/feed/market" }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" },
        { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
      ]
    },
    {
      "source": "/(css|js)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
